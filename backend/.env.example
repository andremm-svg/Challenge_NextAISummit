# Copiaza acest fisier ca .env si completeaza. NU urca .env pe GitHub.

# Ce LLM foloseste agentul: bedrock (Claude prin AWS) sau featherless
LLM_PROVIDER=bedrock

# --- Claude prin Amazon Bedrock (date de la mentor) ---
AWS_REGION=
BEDROCK_MODEL_ID=
# Varianta 1: chei de acces
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# doar daca ai primit si un session token
# AWS_SESSION_TOKEN=
# Varianta 2: cheie API Bedrock (daca ai primit asa ceva in loc de chei de acces)
# AWS_BEARER_TOKEN_BEDROCK=

# --- Featherless (sponsor) ---
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen3-32B
# 1 = tool calling nativ; 0 = protocol JSON (pentru modele care nu suporta tools)
FEATHERLESS_NATIVE_TOOLS=1
